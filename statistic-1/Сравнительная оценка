import pandas as pd
import numpy as np
from google.colab import files

uploaded = files.upload()
filename = list(uploaded.keys())[0]

df = pd.read_excel(filename)

# Извлечение числовых данных из второго столбца
data_column = df.columns[1]
data = df[data_column].values
data = data[~np.isnan(data)]  # Удаление пропущенных значений
n = len(data)
# Расчёт выборочного среднего
x_mean = (1/n) * sum(data)
# Медиана
median = np.median(data)
print(f"Медиана: med = {median:.2f}")

# Размах выборки
R = max(data) - min(data)
print(f"Размах выборки: R = {R:.1f}")

# Минимум и максимум
print(f"Минимум: Xmin = {min(data):.1f}")
print(f"Максимум: Xmax = {max(data):.1f}")
# Расчёт выборочного центрального момента
central_moments = {}
for l in range(1, 5):
    m_l = (1/n) * sum((xi - x_mean)**l for xi in data)
    central_moments[l] = m_l
# Расчёт смещённой выборочной дисперсии через m2
s2 = central_moments[2]
print(f"Значение дисперсии: {s2:.3f}")

# Расчёт среднеквадратичного отклонения
s = np.sqrt(s2)
# Коэффициент вариации
cv = (s / x_mean) * 100
print(f"Коэффициент вариации: CV = {cv:.0f}%")

# Асимметрия
skew = central_moments[3] / (s**3)
print(f"Коэффициент асимметрии: As = {skew:.2f}")

# Эксцесс
kurt = (central_moments[4] / (s**4)) - 3
print(f"Эксцесс: Ex = {kurt:.2f}")
