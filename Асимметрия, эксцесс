import pandas as pd
import numpy as np
from scipy import stats
from google.colab import files

uploaded = files.upload()
filename = list(uploaded.keys())[0]

df = pd.read_excel(filename)

# Извлечение данных из второго столбца
data = df.iloc[:, 1].values
data = data[~np.isnan(data)]

# Основные характеристики
mean = np.mean(data)
median = np.median(data)
s2 = np.std(data, ddof=0)

# Коэффициент асимметрии
skew = stats.skew(data)

# Эксцесс
kurt = stats.kurtosis(data)

# Коэффициент вариации
cv = (s2 / mean) * 100

print(f"Среднее: {mean:.3f} млн. чел.")
print(f"Медиана: {median:.2f} млн. чел.")
print(f"Коэффициент асимметрии: {skew:.2f}")
print(f"Эксцесс: {kurt:.2f}")
print(f"Коэффициент вариации: {cv:.0f}%")
