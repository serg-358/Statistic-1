import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import scipy.stats as stats
from google.colab import files

uploaded = files.upload()
filename = list(uploaded.keys())[0]
df = pd.read_excel(filename)

# Извлечение данных из второго столбца
data_full = df.iloc[:, 1].values
countries_full = df.iloc[:, 0].values

# Сортировка по убыванию значений и исключение 9 выбросов
sorted_indices = np.argsort(data_full)[::-1]
data_sorted = data_full[sorted_indices]

# Исключаем топ-9
data_w_9 = data_sorted[9:]

n = len(data_w_9)
x_mean = np.mean(data_w_9)
median = np.median(data_w_9)
s = np.std(data_w_9, ddof=0)
x_min = min(data_w_9)
x_max = max(data_w_9)

# Интервалы
k = int(1 + 3.3 * np.log10(n))
h = (x_max - x_min) / k
print(f"Число интервалов: k = {k}")
print(f"Длина интервала: h = {h:.2f}")

# Гистограмма плотности
fig, ax = plt.subplots(figsize=(12, 7))
n_values, bins, patches = ax.hist(data_w_9, bins=k, density=True, edgecolor='black', linewidth=1.2, alpha=0.7, color='skyblue',
label='Эмпирическое распределение')

# Кривая нормального распределения для усеченной выборки
x = np.linspace(x_min, x_max, 100)
pdf_normal = stats.norm.pdf(x, x_mean, s)
ax.plot(x, pdf_normal, 'r-', linewidth=2.5, label=f'Нормальное распределение')

# Линии среднего и медианы
ax.axvline(x_mean, color='red', linestyle='--', linewidth=2, label=f'Среднее = {x_mean:.2f}')
ax.axvline(median, color='green', linestyle='--', linewidth=2, label=f'Медиана = {median:.2f}')

# Оформление графика
ax.set_xlabel('Количество международных туристов (млн. чел.)', fontsize=11, fontweight='bold')
ax.set_ylabel('Плотность вероятности', fontsize=11, fontweight='bold')
ax.set_title('Гистограмма плотности распределения туристических прибытий по странам Азии и Тихого океана (2023) (без 9 стран-лидеров)',
fontsize=13, fontweight='bold', pad=15)
ax.legend(fontsize=10, loc='upper right')
ax.grid(axis='y', alpha=0.3, linestyle='--')
ax.set_axisbelow(True)
plt.tight_layout()
plt.savefig('density_histogram_without_top7.png', dpi=300, bbox_inches='tight')
plt.show()

# Сравнение с показателями полной выборки
mean_full = np.mean(data_full)
median_full = np.median(data_full)
s_full = np.std(data_full, ddof=0)
print("Среднее:")
print(f"До: {mean_full:.3f}, после: {x_mean:.3f}")
print("Медиана:")
print(f"До: {median_full:.3f}, после: {median:.3f}")
print("Среднеквадратичное отклонение:")
print(f"До: {s_full:.3f}, после: {s:.3f}")

# Коэффициент асимметрии
skew_full = stats.skew(data_full)
skew_new = stats.skew(data_w_9)
print("Асимметрия:")
print(f"До: {skew_full:.3f}, после: {skew_new:.3f}")

# Эксцесс
kurt_full = stats.kurtosis(data_full)
kurt_new = stats.kurtosis(data_w_9)
print("Эксцесс:")
print(f"До: {kurt_full:.3f}, после: {kurt_new:.3f}")

# Коэффициент вариации
cv_full = (s_full / mean_full) * 100
cv_new = (s / x_mean) * 100
print("Коэффициент вариации:")
print(f"До: {cv_full:.0f}, после: {cv_new:.0f}")
