import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import scipy.stats as stats
from scipy.stats import chi2
from google.colab import files

uploaded = files.upload()
filename = list(uploaded.keys())[0]
df = pd.read_excel(filename)

data = df.iloc[:, 1].values
data = data[~np.isnan(data)]
n = len(data)

x_min = min(data)
x_max = max(data)
R = x_max - x_min

k = int(1 + 3.3 * np.log10(n))
h = R / k
print(f"Число интервалов: k = {k}")
print(f"Длина интервала: h = {h:.1f}")

fig, ax = plt.subplots(figsize=(10, 6))

ax.hist(data, bins=k, density=True,
        edgecolor='black', linewidth=1.2,
        alpha=0.7, color='skyblue',
        label='Эмпирическое распределение')

x = np.linspace(x_min, x_max, 100)
x_mean = np.mean(data)
s = np.std(data, ddof=0)
pdf_normal = stats.norm.pdf(x, x_mean, s)
ax.plot(x, pdf_normal, 'r-', linewidth=2.5, label='Нормальное распределение')

ax.set_xlabel('Количество международных туристов (млн. чел.)', fontsize=11, fontweight='bold')
ax.set_ylabel('Плотность вероятности', fontsize=11, fontweight='bold')
ax.set_title('Гистограмма плотности распределения\nтуристических прибытий по странам Азии и Тихого океана (2023)',
             fontsize=13, fontweight='bold', pad=15)
ax.legend(fontsize=10, loc='best')
ax.grid(axis='y', alpha=0.3, linestyle='--')
ax.set_axisbelow(True)
plt.tight_layout()
plt.show()

frequencies, bin_edges = np.histogram(data, bins=k)

chi2_components = []
for i in range(k):
    p = stats.norm.cdf(bin_edges[i+1], x_mean, s) - stats.norm.cdf(bin_edges[i], x_mean, s)
    exp_freq = n * p
    if exp_freq > 0:
        chi2_comp = (frequencies[i] - exp_freq)**2 / exp_freq
    else:
        chi2_comp = 0
    chi2_components.append(chi2_comp)
    print(f"{frequencies[i]} {p:10.3f} {exp_freq:12.3f} {chi2_comp:12.3f}")

chi2_stat = np.sum(chi2_components)
print(f"Хи-квадрат: {chi2_stat:.3f}")

l = 2
r = k - 1 - l
print(f"Число степеней свободы: r = {r}")

alpha = 0.05
quantile = chi2.ppf(1 - alpha, r)
print(f"Значение квантиля распределения ({r}; {1-alpha}): {quantile:.3f}")
