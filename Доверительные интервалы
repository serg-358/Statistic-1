import pandas as pd
import numpy as np
from scipy import stats
from google.colab import files

# Загрузка данных
uploaded = files.upload()
filename = list(uploaded.keys())[0]
df = pd.read_excel(filename)
data = df.iloc[:, 1].values
data = data[~np.isnan(data)]

# Параметры
n = len(data)
alpha = 0.05
confidence_level = 1 - alpha

# Основные характеристики
x_mean = np.mean(data)
s = np.std(data, ddof=0)
skewness = stats.skew(data)
excess_kurtosis = stats.kurtosis(data)  # Это уже e (эксцесс)

# Квантиль нормального распределения
u = stats.norm.ppf(1 - alpha/2)

print("Исходные данные:")
print(f"Объем выборки: n = {n}")
print(f"Выборочное среднее: x = {x_mean:.3f}")
print(f"Выборочное СКО: s = {s:.3f}")
print(f"Эксцесс: e = {excess_kurtosis:.3f}")
print(f"Уровень значимости: a = {alpha}")
print(f"Доверительная вероятность: {confidence_level}")
print(f"Квантиль u = {u:.3f}")

# Погрешность
delta_mean = (s * u) / np.sqrt(n)

# Границы
ci_mean_lower = x_mean - delta_mean
ci_mean_upper = x_mean + delta_mean

print(f"Погрешность: {delta_mean:.3f}")
print(f"Доверительный интервал матожидания: ({ci_mean_lower:.3f}; {ci_mean_upper:.3f})")

# Коэффициент для расчета
coef = 0.5 * u * np.sqrt((excess_kurtosis + 2) / n)

# Границы
ci_std_lower = s * (1 - coef)
ci_std_upper = s * (1 + coef)

print(f"Коэффициент: = {coef:.3f}")
print(f"Доверительный интервал для СКО: ({ci_std_lower:.3f}; {ci_std_upper:.3f})")
